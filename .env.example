# App
PUBLIC_BASE_URL=
DATABASE_PATH=./data/palkova.db
RESTAURANT_TZ=America/New_York
OWNER_PASSWORD=
SESSION_SECRET=

# PayPal (sandbox app). PAYPAL_PLAN_ID and PAYPAL_WEBHOOK_ID come from `python -m scripts.setup_paypal`.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID=

# OpenAI. Voice model, then the command bar's and the Takings agents' (each falls back to the one before).
LLM_API_KEY=
LLM_MODEL=
COMMAND_LLM_MODEL=
STUDIO_LLM_MODEL=

# Voice (Vapi) and SMS (Twilio)
VAPI_PUBLIC_KEY=
VAPI_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
FORWARD_NUMBER=
CALL_LIMIT_EXEMPT_NUMBER=

# Web build: read by `npm run build`, not by the server. Without keys, AG Grid and AG Studio show a watermark.
VITE_AG_GRID_LICENSE=
VITE_AG_STUDIO_LICENSE=

# Only for hosts with no persistent disk: snapshot SQLite to a private Supabase Storage bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DB_SNAPSHOT_BUCKET=

# Meal Buddy (examples/meal_buddy), a separate service; the app ignores these.
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
XAI_API_KEY=
PALKOVA_URL=
